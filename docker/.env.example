# Copy to .env and fill in. `node docker/generate-keys.mjs` prints a valid set
# of the secrets below (the JWTs must be signed with JWT_SECRET).

# Where the app itself is reachable from a browser.
SITE_URL=http://localhost:3000
# Where the Supabase gateway is reachable from a browser. It must be the public
# address, not an internal hostname: the browser talks to it directly.
SUPABASE_PUBLIC_URL=http://localhost:8100

APP_PORT=3000
SUPABASE_PORT=8100

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
CRON_SECRET=

REALTIME_SECRET_KEY_BASE=
REALTIME_ENC_KEY=

# Optional: fallback for the AI Response node when no key is set in Settings.
AI_GATEWAY_API_KEY=

# Set to false and configure GOTRUE_SMTP_* in docker-compose.yml if you want
# email confirmation instead of instant signup.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com
